{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "server/assets/**"
    },
    "api/tg.js": {
      "includeFiles": "server/assets/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/app.html",
      "permanent": false
    }
  ]
}
